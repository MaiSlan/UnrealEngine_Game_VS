# Unreal Engine — copy this file to the project root and rename it to ".gitignore"

# Generated by the engine / build
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.suo
*.xcodeproj
*.xcworkspace

# Visual Studio / Rider
.vs/
.idea/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Platform / OS junk
.DS_Store
Thumbs.db
desktop.ini

# Packaged builds (store releases elsewhere)
/PackagedBuilds/
/Packaged/

# Secrets — never commit
.env
*.pem
*.key
